{
  "name": "kripto-7hon",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/ui": "~58.0.21",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-image": "~58.0.16",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "html-to-image": "^1.11.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "data:live": "uv run --project backend kripto live",
    "report:draft": "uv run --project backend kripto weekly",
    "validate": "uv run --project backend kripto validate",
    "api": "uv run --project backend kripto serve",
    "prebuild:web": "tsx scripts/prepare-build.ts",
    "export:web": "npm run prebuild:web && expo export -p web && tsx scripts/paint-first.ts && tsx scripts/fix-static-index.ts",
    "samples": "tsx scripts/dev/make-samples.ts",
    "check:links": "tsx scripts/dev/check-links.ts",
    "fixtures:capture": "uv run --project backend kripto fixtures-capture",
    "feeds:probe": "uv run --project backend kripto feeds-probe",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:backend": "cd backend && uv run pytest -q && uv run ruff check . && uv run ruff format --check . && uv run mypy",
    "lint": "expo lint",
    "format": "prettier --write ."
  },
  "private": true
}
